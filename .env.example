# Flatimo Mail - Environment Configuration

# Server Port (Local standalone only)
PORT=3000
NODE_ENV=production

# Default Domains (pisahkan dengan koma)
DOMAINS=mailflatimo.web.id,flatimostore.my.id,flatimo.me

# Master API Key
API_KEY=FLATIMOSTORE
API_KEYS=FLATIMOSTORE,FLATIMO_ADMIN

# Email Retention Period (Hours)
RETENTION_HOURS=24

# Cloud Storage / Redis (Opsional untuk Vercel Serverless Persistence)
# Buat gratis di https://upstash.com (pilih Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inbound Webhook Secret (Opsional jika ingin proteksi webhook)
WEBHOOK_SECRET=

# Telegram Bot Token (Opsional jika mengaktifkan Bot Telegram)
TELEGRAM_BOT_TOKEN=
