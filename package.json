{
  "name": "flatimo-mail",
  "version": "1.0.0",
  "description": "Flatimo Mail - Lightning Fast Disposable Temp Mail with Built-in SMTP, Public REST API & Real-time Web UI",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
